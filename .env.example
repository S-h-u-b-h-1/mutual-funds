# Copy to .env and fill in. Local Docker defaults shown.
PGHOST=localhost
PGPORT=5432
PGDATABASE=mfpulse
PGUSER=mfpulse
PGPASSWORD=mfpulse

# For a hosted DB (e.g. Supabase), set a single URL instead — it wins over the PG* vars:
# DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Airflow / alerting (Phase 2)
SLACK_WEBHOOK_URL=

# Mutual-fund distribution execution gate. Keep every value false until documentary evidence,
# production provider configuration, UAT and compliance sign-off have been completed.
INVESTMENT_EXECUTION_ENABLED=false
AMFI_ARN_VERIFIED=false
AMFI_EUIN_VERIFIED=false
AMFI_DSC_CURRENT=false
AMC_EMPANELMENT_VERIFIED=false
ORDER_RAIL_AGREEMENT_VERIFIED=false
KYC_RAIL_VERIFIED=false
PAYMENT_RAIL_VERIFIED=false
TRANSACTION_2FA_VERIFIED=false
REGULAR_PLAN_CONTROLS_VERIFIED=false
MF_DISTRIBUTION_DISCLOSURES_VERIFIED=false
MF_GOVERNANCE_REVIEW_VERIFIED=false
