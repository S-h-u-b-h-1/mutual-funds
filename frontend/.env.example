# Existing public read-only data connection
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pulse AI — server-only. Copy these to frontend/.env.local (or Vercel preview env).
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.5-4B
AI_FEATURE_ENABLED=false
# YYYY-MM-DD after verifying both input and output remain free; expires after 7 days.
AI_FREE_MODEL_VERIFIED_ON=
